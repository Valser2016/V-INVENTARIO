# Copy this file to .env and replace values before production deployment.
# Never commit real secrets or production credentials.

DJANGO_ENV=production
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=example-backend.railway.app
CORS_ALLOWED_ORIGINS=https://example-frontend.railway.app
CSRF_TRUSTED_ORIGINS=https://example-frontend.railway.app

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Alternatively, remove DATABASE_URL and configure these variables instead:
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Optional outgoing email (required only if the application sends emails):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False
